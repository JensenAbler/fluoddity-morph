[Unit]
Description=fluoddity-morph telemetry receiver (POST /api/log -> daily JSONL)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /srv/fluoddity-morph/server/log_receiver.py
Environment=LOG_DIR=/var/lib/fluoddity-morph/logs
Environment=PORT=8787
DynamicUser=yes
StateDirectory=fluoddity-morph
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
